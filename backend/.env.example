DATABASE_URL="postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require&channel_binding=require"

# Cloudinary: preencha no .env local; nunca publique a chave secreta.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Token gratuito de https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=

# Painel de Economia: chaves somente no servidor.
# AwesomeAPI é opcional; sem chave, usa o endpoint público com cache.
AWESOME_API_KEY=
# CoinGecko: chave do plano Demo gratuito.
COINGECKO_API_KEY=
